\contentsline {figure}{\numberline {1}{\ignorespaces Three-level atomic configurations: (left) $\Lambda $-system, (middle) V-system, and (right) $\Xi $-system.\relax }}{6}{figure.caption.3}%
\contentsline {figure}{\numberline {2}{\ignorespaces A thee-level $\Lambda $-system with natural transition frequencies $\omega _{13}$ and $\omega _{23}$ which is driven near-resonance by detuned beams operating at $\omega _p$ and $\omega _c$\relax }}{6}{figure.caption.4}%
\contentsline {figure}{\numberline {3}{\ignorespaces A diamond configuration atomic system with non-degenerate energy levels $\ket {1}, \ket {2}, \ket {3}, \ket {4}$. The system has allowed transitions $\ket {1} \leftrightarrow \ket {2}$, $\ket {1} \leftrightarrow \ket {3}$, $\ket {2} \leftrightarrow \ket {4}$, and $\ket {3} \leftrightarrow \ket {4}$ with respective energies $\hbar \omega _{12}$, $\hbar \omega _{13}$, $\hbar \omega _{24}$, and $\hbar \omega _{34}$ and corresponding wavelengths $\lambda _{12}$, $\lambda _{13}$, $\lambda _{24}$, and $\lambda _{34}$.\relax }}{7}{figure.caption.5}%
\contentsline {figure}{\numberline {4}{\ignorespaces (Top) the lab frame in which an atom moves towards an electromagnetic wave with velocity $v$ and (bottom) the atomic reference frame in which the atom observes a shift in the field frequency via a Doppler shift.\relax }}{8}{figure.caption.6}%
\contentsline {figure}{\numberline {5}{\ignorespaces A cartoon depiction of FWM in a $\chi ^{(3)}$ medium involving three beams of frequencies $\omega _a$, $\omega _b$, and $\omega _c$ which mix to produce a field of frequency $\omega _d$.\relax }}{8}{figure.caption.7}%
\contentsline {figure}{\numberline {6}{\ignorespaces Cartoon depiction of optical squeezing in the conjugate phase and amplitude quadratures with (left) unmodified light and (right) squeezed light.\relax }}{10}{figure.caption.8}%
\contentsline {figure}{\numberline {7}{\ignorespaces (Left) the electric field experienced by a point within a region of an atomic medium and (right) a different electric field experienced by a neighboring region.\relax }}{12}{figure.caption.9}%
\contentsline {figure}{\numberline {8}{\ignorespaces A four-level diamond configuration atom driven by three external fields where fields $\omega _I$ and $\omega _{II}$ are strong pump fields and field $\omega _s$ is the weak input signal field. These fields have respective detunings $\Delta _I$, $\Delta _{II}$, and $\Delta _s$.\relax }}{15}{figure.caption.10}%
\contentsline {figure}{\numberline {9}{\ignorespaces Gaussian velocity distribution separated into 9 velocity subclasses marked by blue lines. Calculated for $^{87}Rb$ at $333$ K.\relax }}{17}{figure.caption.11}%
\contentsline {figure}{\numberline {10}{\ignorespaces Depiction of the system for a Jaynes-Cummings model with (left) a resonant cavity containing a single atom in the presence of a driving electromagnetic field resonant with the cavity frequency of $\omega $, with (right) the atomic system depicted as a two-level atom of transition frequency $\omega _a$.\relax }}{20}{figure.caption.12}%
\contentsline {figure}{\numberline {11}{\ignorespaces Decaying Rabi oscillation produced by the Jaynes-Cummings model with initial state $\ket {\psi }_0 = \ket {e} \otimes \ket {0}$.\relax }}{22}{figure.caption.13}%
\contentsline {figure}{\numberline {12}{\ignorespaces The real and imaginary components of the density matrix element $\rho _{31} = \bigl \langle \hat {\sigma } \bigr \rangle $ over a range of detunings $\Delta _s$. The response indicates the presence of EIT and slowed light propagation at resonance.\relax }}{24}{figure.caption.14}%
\contentsline {figure}{\numberline {13}{\ignorespaces Decaying Rabi oscillation produced by the Jaynes-Cummings model with initial state $\ket {\psi }_0 = \ket {e} \otimes \ket {0}$ with the introduction of noise by including $\varepsilon \hat {a} + \varepsilon ^{*} \hat {a}^{\dagger }$ to the Hamiltonian in Eq.\nobreakspace {}\eqref {JCMHamiltonian}.\relax }}{25}{figure.caption.15}%
\contentsline {figure}{\numberline {14}{\ignorespaces Reproduction of a portion of figure 1(c) from `Coherent Control of Quantum Fluctuations Using Cavity Electromagnetically Induced Transparency' by Souza et al.\nobreakspace {}\cite {Souza} depicting the expected photon count within the cavity over a range of frequency detunings $\Delta $.\relax }}{26}{figure.caption.16}%
\contentsline {figure}{\numberline {15}{\ignorespaces Reproduction of a portion of figure 1(c) from `Coherent Control of Quantum Fluctuations Using Cavity Electromagnetically Induced Transparency' by Souza et al.\nobreakspace {}\cite {Souza} --- which has been slightly modified and added upon for clarity --- depicting (top) the state expectation values of states in an energy split and rotated basis over a range of detunings and (bottom) the state expectation values of states in the atomic basis over a range of detunings.\relax }}{26}{figure.caption.17}%
\contentsline {figure}{\numberline {16}{\ignorespaces Diamond configuration atom diagrams. (Left) Duplicate of Fig.\nobreakspace {}\ref {FirstDiamondAtom} placed for convenience. A diamond configuration atomic system with non-degenerate energy levels $\ket {1}, \ket {2}, \ket {3}, \ket {4}$. The system has allowed transitions $\ket {1} \leftrightarrow \ket {2}$, $\ket {1} \leftrightarrow \ket {3}$, $\ket {2} \leftrightarrow \ket {4}$, and $\ket {3} \leftrightarrow \ket {4}$ with respective energies $\hbar \omega _{12}$, $\hbar \omega _{13}$, $\hbar \omega _{24}$, and $\hbar \omega _{34}$ and corresponding wavelengths $\lambda _{12}$, $\lambda _{13}$, $\lambda _{24}$, and $\lambda _{34}$. (Right) A strong pump drives transition $\ket {1} \leftrightarrow \ket {3}$ at frequency $\omega _I$ with detuning $\Delta _I = \omega _I - \omega _{13}$, a separate strong pump drives transition $\ket {2} \leftrightarrow \ket {4}$ with detuning $\Delta _{II} = \omega _{II} - \omega _{24}$, a weak signal beam drives transition $\ket {1} \leftrightarrow \ket {2}$ with detuning $\Delta _{s} = \omega _{s} - \omega _{12}$, and a weak idler field (undriven) is induced by the presence of the other fields through a FWM process, resulting in transition $\ket {3} \leftrightarrow \ket {4}$ with emission detuning $\Delta _{i} = \omega _{i} - \omega _{34}$.\relax }}{31}{figure.caption.19}%
